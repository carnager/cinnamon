#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version="${POPCORN_RELEASE_VERSION:-$(cd "$repo_root" && git describe --tags --always --dirty)}"
out_dir="${POPCORN_RELEASE_DIR:-$repo_root/dist/$version}"
commit="$(cd "$repo_root" && git rev-parse --short HEAD 2>/dev/null || true)"
build_time="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
android_version_code="${POPCORN_ANDROID_VERSION_CODE:-$(($(date -u +%s) / 60))}"
android_version_name="${POPCORN_ANDROID_VERSION_NAME:-$version}"
release_upload="${POPCORN_RELEASE_UPLOAD:-}"

if [[ -z "${JAVA_HOME:-}" && -d /usr/lib/jvm/java-21-openjdk ]]; then
  export JAVA_HOME=/usr/lib/jvm/java-21-openjdk
fi

apk_abis() {
  local apk="$1"
  unzip -l "$apk" 'lib/*/*.so' \
    | awk '/lib\// { split($4, parts, "/"); print parts[2] }' \
    | sort -u \
    | paste -sd, -
}

apk_size() {
  du -h "$1" | awk '{ print $1 }'
}

mkdir -p "$out_dir"
out_dir="$(cd "$out_dir" && pwd -P)"
rm -f "$out_dir/app-update.toml"

echo "==> release $version"
echo "==> output $out_dir"

echo "==> go test ./..."
(cd "$repo_root" && go test ./...)

echo "==> build popcornd"
(cd "$repo_root" && go build -trimpath -ldflags "-s -w -X popcorn/internal/version.Version=$version -X popcorn/internal/version.Commit=$commit -X popcorn/internal/version.BuildTime=$build_time" -o "$out_dir/popcornd" ./cmd/popcornd)

echo "==> build popcorn-mpv"
(cd "$repo_root" && go build -trimpath -ldflags "-s -w" -o "$out_dir/popcorn-mpv" ./cmd/popcorn-mpv)

echo "==> build Android APKs"
(cd "$repo_root/android-tv" && POPCORN_ANDROID_VERSION_CODE="$android_version_code" POPCORN_ANDROID_VERSION_NAME="$android_version_name" ./gradlew :app:assembleRelease :companion:assembleRelease)

tv_apk="$out_dir/popcorn-tv-$version.apk"
companion_apk="$out_dir/popcorn-companion-$version.apk"

cp "$repo_root/android-tv/app/build/outputs/apk/release/app-release.apk" "$tv_apk"
cp "$repo_root/android-tv/companion/build/outputs/apk/release/companion-release.apk" "$companion_apk"
cp "$repo_root/config.example.toml" "$out_dir/config.example.toml"
cp "$repo_root/packaging/popcornd.service" "$out_dir/popcornd.service"

tv_abis="$(apk_abis "$tv_apk")"
if [[ "$tv_abis" != "arm64-v8a" ]]; then
  echo "Android TV APK contains unexpected native ABIs: ${tv_abis:-none}" >&2
  echo "Expected arm64-v8a only. Check android-tv/app/build.gradle.kts ndk.abiFilters." >&2
  exit 1
fi

(
  cd "$out_dir"
  sha256sum popcornd popcorn-mpv "popcorn-tv-$version.apk" "popcorn-companion-$version.apk" config.example.toml popcornd.service > SHA256SUMS
)

echo "==> wrote:"
find "$out_dir" -maxdepth 1 -type f -printf '  %f\n' | sort

echo
echo "==> APK version metadata:"
echo "  versionCode:      $android_version_code"
echo "  versionName:      $android_version_name"
echo "  Android TV APK:   $(apk_size "$tv_apk") ($tv_abis, release/R8)"
echo "  Companion APK:    $(apk_size "$companion_apk")"

if [[ -z "$release_upload" && -n "${POPCORN_UPLOAD_SERVER:-}" ]]; then
  release_upload=1
fi

case "${release_upload,,}" in
  1|true|yes)
    upload_updates=1
    ;;
  ""|0|false|no)
    upload_updates=0
    ;;
  *)
    echo "POPCORN_RELEASE_UPLOAD must be 1/true/yes or 0/false/no" >&2
    exit 2
    ;;
esac

if [[ "$upload_updates" == 1 ]]; then
  echo
  echo "==> upload Android TV update"
  POPCORN_UPLOAD_VERSION_CODE="$android_version_code" \
    POPCORN_UPLOAD_VERSION_NAME="$android_version_name" \
    POPCORN_UPDATE_NOTES="${POPCORN_TV_RELEASE_NOTES:-${POPCORN_RELEASE_NOTES:-}}" \
    "$repo_root/scripts/upload-app-update" tv "$out_dir/popcorn-tv-$version.apk"

  echo
  echo "==> upload Phone Companion update"
  POPCORN_UPLOAD_VERSION_CODE="$android_version_code" \
    POPCORN_UPLOAD_VERSION_NAME="$android_version_name" \
    POPCORN_UPDATE_NOTES="${POPCORN_COMPANION_RELEASE_NOTES:-${POPCORN_RELEASE_NOTES:-}}" \
    "$repo_root/scripts/upload-app-update" companion "$out_dir/popcorn-companion-$version.apk"
else
  echo
  echo "==> upload these APKs in the web admin App Updates screen,"
  echo "==> or publish them with scripts/upload-app-update:"
  echo "  Android TV:       $out_dir/popcorn-tv-$version.apk"
  echo "  Phone Companion:  $out_dir/popcorn-companion-$version.apk"
fi
