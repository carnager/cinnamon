#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/popcorn"
CONFIG_FILE="$CONFIG_DIR/mpv-wrapper.conf"
SERVER="${POPCORN_SERVER:-}"
TOKEN="${POPCORN_TOKEN:-}"
USERNAME="${POPCORN_USERNAME:-}"
PASSWORD="${POPCORN_PASSWORD:-}"

need() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'Missing dependency: %s\n' "$1" >&2
    exit 1
  }
}

need curl
need jq
need mpv
need rofi
need socat

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi

mkdir -p "$CONFIG_DIR"

ROFI_THEME="$(rofi -dump-theme 2>/dev/null || true)"

rofi_theme_font_line() {
  printf '%s\n' "$ROFI_THEME" | awk '/font:/ {sub(/^[[:space:]]*font:[[:space:]]*/, ""); sub(/;[[:space:]]*$/, ""); print; exit}'
}

rofi_font_size() {
  local font_line
  font_line="$(rofi_theme_font_line)"
  if [[ "$font_line" =~ ([0-9]+)(\.[0-9]+)?\"?$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  else
    printf '14\n'
  fi
}

rofi_window_width() {
  printf '%s\n' "$ROFI_THEME" |
    awk '
      $1 == "window" {in_window=1}
      in_window && /}/ {in_window=0}
      in_window && /width:/ {
        gsub(/[^0-9.]/, "", $2)
        if ($2 != "") print int($2)
        exit
      }
    '
}

rofi_is_mono_font() {
  local font_line
  font_line="$(rofi_theme_font_line | tr '[:upper:]' '[:lower:]')"
  [[ "$font_line" == *mono* || "$font_line" == *code* || "$font_line" == *console* || "$font_line" == *term* ]]
}

rofi_columns() {
  if [[ -n "${POPCORN_ROFI_COLUMNS:-}" ]]; then
    printf '%s\n' "$POPCORN_ROFI_COLUMNS"
    return
  fi
  local width size cols
  width="$(rofi_window_width)"
  size="$(rofi_font_size)"
  if [[ -z "$width" || "$width" -le 0 ]]; then
    printf '110\n'
    return
  fi
  # Rofi theme width is the whole window, not the readable list text area.
  # Keep rows compact by default; POPCORN_ROFI_COLUMNS can override this.
  cols="$(( (width - 240) / size ))"
  if (( cols < 54 )); then cols=54; fi
  if (( cols > 96 )); then cols=96; fi
  printf '%s\n' "$cols"
}

ROFI_COLUMNS="$(rofi_columns)"
ROFI_ARGS=()
if ! rofi_is_mono_font; then
  ROFI_ARGS=(-theme-str "element-text { font: \"monospace $(rofi_font_size)\"; }")
fi

rofi_dmenu() {
  rofi "${ROFI_ARGS[@]}" -dmenu "$@"
}

rofi_prompt() {
  local prompt="$1"
  rofi_dmenu -p "$prompt"
}

rofi_password() {
  local prompt="$1"
  rofi_dmenu -password -p "$prompt"
}

save_config() {
  umask 077
  cat >"$CONFIG_FILE" <<EOF
SERVER=$(printf '%q' "$SERVER")
TOKEN=$(printf '%q' "$TOKEN")
USERNAME=$(printf '%q' "$USERNAME")
EOF
}

ensure_config() {
  if [[ -z "$SERVER" ]]; then
    SERVER="$(rofi_prompt "Popcorn server" <<<"http://localhost:8097")"
  fi
  SERVER="${SERVER%/}"
  if [[ -z "$TOKEN" ]]; then
    if [[ -z "$USERNAME" ]]; then
      USERNAME="$(rofi_prompt "Popcorn user" </dev/null)"
    fi
    if [[ -z "$PASSWORD" ]]; then
      PASSWORD="$(rofi_password "Popcorn password" </dev/null)"
    fi
    TOKEN="$(
      curl -fsS "$SERVER/api/auth/login" \
        -H "Content-Type: application/json" \
        -d "$(jq -nc --arg username "$USERNAME" --arg password "$PASSWORD" '{username:$username,password:$password}')" |
        jq -r '.token // empty'
    )"
    if [[ -z "$TOKEN" ]]; then
      rofi -e "Popcorn login returned no token"
      exit 1
    fi
    save_config
  fi
}

api() {
  local path="$1"
  curl -fsS "$SERVER$path" -H "Authorization: Bearer $TOKEN"
}

api_put_json() {
  local path="$1"
  local body="$2"
  curl -fsS -X PUT "$SERVER$path" \
    -H "Authorization: Bearer $TOKEN" \
    -H "Content-Type: application/json" \
    -d "$body" >/dev/null
}

uri() {
  jq -rn --arg v "$1" '$v|@uri'
}

fmt_duration_jq='
def dur:
  if (.durationMs // 0) <= 0 then ""
  else
    ((.durationMs / 1000) | floor) as $s |
    (($s / 3600) | floor) as $h |
    ((($s % 3600) / 60) | floor) as $m |
    ([($h|tostring), ($m|tostring)] | map(if length == 1 then "0" + . else . end) | join(":"))
  end;
def year: if (.year // 0) > 0 then (.year|tostring) else "----" end;
def fit($title; $meta; $cols):
  ($meta | length) as $ml |
  (($cols - $ml - 2) | if . < 12 then 12 else . end) as $tw |
  ($title | if length > $tw then .[0:($tw - 3)] + "..." else . end) as $t |
  ($cols - ($t | length) - $ml | if . < 2 then 2 else . end) as $gap |
  $t + (" " * $gap) + $meta;
def movie_label:
  fit(.title; ("[" + year + "]" + (dur as $d | if $d != "" then "  " + $d else "" end)); $cols);
def episode_code:
  "S" + ((.seasonNumber // 0)|tostring|if length == 1 then "0" + . else . end) +
  "E" + ((.episodeNumber // 0)|tostring|if length == 1 then "0" + . else . end);
def episode_label:
  fit((episode_code + "  " + ((.episodeTitle // .title))); dur; $cols);
'

choose_from_tsv() {
  local prompt="$1"
  local rows="$2"
  local chosen
  chosen="$(printf '%s\n' "$rows" | cut -f2- | rofi_dmenu -i -p "$prompt")"
  [[ -n "$chosen" ]] || return 1
  printf '%s\n' "$rows" | awk -F '\t' -v c="$chosen" 'substr($0, length($1) + 2) == c {print $1; exit}'
}

choose_movie() {
  local rows
  rows="$(
    api "/api/items?libraryId=movies&limit=2000" |
      jq -r --argjson cols "$ROFI_COLUMNS" "$fmt_duration_jq .[] | [.id, movie_label] | @tsv"
  )"
  choose_from_tsv "Movie" "$rows"
}

choose_search_result() {
  local query rows
  query="$(rofi_prompt "Search" </dev/null)"
  [[ -n "$query" ]] || return 1
  rows="$(
    api "/api/search?limit=100&q=$(uri "$query")" |
      jq -r --argjson cols "$ROFI_COLUMNS" "$fmt_duration_jq .items[] | select(.kind == \"movie\" or .kind == \"episode\") |
        [.id,
         (if .kind == \"episode\"
          then fit((\"TV     \" + ((.showTitle // .title)) + \"  \" + episode_code + \"  \" + ((.episodeTitle // .title))); dur; \$cols)
          else fit((\"MOVIE  \" + .title); (\"[\" + year + \"]\" + (dur as \$d | if \$d != \"\" then \"  \" + \$d else \"\" end)); \$cols)
          end)
        ] | @tsv"
  )"
  choose_from_tsv "Play" "$rows"
}

choose_episode() {
  local show_rows show_key library_id show_title season_rows season episodes_rows
  show_rows="$(
    api "/api/tv/shows?libraryId=tv_shows&limit=2000" |
      jq -r --argjson cols "$ROFI_COLUMNS" '
        def fit($title; $meta; $cols):
          ($meta | length) as $ml |
          (($cols - $ml - 2) | if . < 12 then 12 else . end) as $tw |
          ($title | if length > $tw then .[0:($tw - 3)] + "..." else . end) as $t |
          ($cols - ($t | length) - $ml | if . < 2 then 2 else . end) as $gap |
          $t + (" " * $gap) + $meta;
        .[] | [(.libraryId + "|" + .title), fit(.title; ("[" + ((.seasonCount // 0)|tostring) + "s/" + ((.episodeCount // 0)|tostring) + "e]"); $cols)] | @tsv'
  )"
  show_key="$(choose_from_tsv "Show" "$show_rows")" || return 1
  library_id="${show_key%%|*}"
  show_title="${show_key#*|}"

  season_rows="$(
    api "/api/tv/seasons?libraryId=$(uri "$library_id")&showTitle=$(uri "$show_title")" |
      jq -r --argjson cols "$ROFI_COLUMNS" '
        def fit($title; $meta; $cols):
          ($meta | length) as $ml |
          (($cols - $ml - 2) | if . < 12 then 12 else . end) as $tw |
          ($title | if length > $tw then .[0:($tw - 3)] + "..." else . end) as $t |
          ($cols - ($t | length) - $ml | if . < 2 then 2 else . end) as $gap |
          $t + (" " * $gap) + $meta;
        def sn: "S" + ((.seasonNumber|tostring)|if length == 1 then "0" + . else . end);
        .[] | [(.seasonNumber|tostring), fit((sn + "  " + (if (.title // "") != "" then .title else "Season " + (.seasonNumber|tostring) end)); ("[" + ((.episodeCount // 0)|tostring) + "e]"); $cols)] | @tsv'
  )"
  season="$(choose_from_tsv "Season" "$season_rows")" || return 1

  episodes_rows="$(
    api "/api/tv/episodes?libraryId=$(uri "$library_id")&showTitle=$(uri "$show_title")&season=$season" |
      jq -r --argjson cols "$ROFI_COLUMNS" "$fmt_duration_jq .[] | [.id, episode_label] | @tsv"
  )"
  choose_from_tsv "Episode" "$episodes_rows"
}

item_json() {
  local item_id="$1"
  api "/api/items/$item_id"
}

progress_json() {
  local item_id="$1"
  api "/api/items/$item_id/progress" 2>/dev/null || printf '{}'
}

save_progress() {
  local item_id="$1"
  local position_ms="$2"
  local duration_ms="$3"
  local state="$4"
  local completed="$5"
  local body
  body="$(jq -nc \
    --argjson positionMs "$position_ms" \
    --argjson durationMs "$duration_ms" \
    --argjson completed "$completed" \
    --arg state "$state" \
    '{positionMs:$positionMs,durationMs:$durationMs,completed:$completed,state:$state}')"
  api_put_json "/api/items/$item_id/progress" "$body" || true
}

mpv_get() {
  local socket="$1"
  local prop="$2"
  printf '{"command":["get_property","%s"]}\n' "$prop" |
    socat - "$socket" 2>/dev/null |
    jq -r '.data // empty' 2>/dev/null || true
}

play_item() {
  local item_id="$1"
  local item title duration_ms progress position_ms resume start_arg stream_url socket_dir socket state_file mpv_pid status

  item="$(item_json "$item_id")"
  title="$(jq -r 'if .kind == "episode" then ((.showTitle // .title) + " - " + (.episodeTitle // .title)) else .title end' <<<"$item")"
  duration_ms="$(jq -r '.durationMs // 0' <<<"$item")"
  progress="$(progress_json "$item_id")"
  position_ms="$(jq -r '.positionMs // 0' <<<"$progress")"

  start_arg=()
  if (( position_ms > 60000 )) && [[ "$(jq -r '.completed // false' <<<"$progress")" != "true" ]]; then
    resume="$(printf 'Resume at %s\nStart from beginning\n' "$(date -u -d "@$((position_ms / 1000))" +%H:%M:%S)" | rofi_dmenu -p "Resume?")"
    if [[ "$resume" == Resume* ]]; then
      start_arg=(--start="$((position_ms / 1000))")
    fi
  fi

  stream_url="$SERVER/api/items/$item_id/stream"
  socket_dir="$(mktemp -d "/tmp/popcorn-mpv-$item_id.XXXXXX")"
  socket="$socket_dir/mpv.sock"
  state_file="$socket_dir/state.json"
  printf '{"positionMs":0,"durationMs":%s}\n' "$duration_ms" >"$state_file"

  save_progress "$item_id" "${position_ms:-0}" "$duration_ms" "start" false

  mpv \
    --force-media-title="$title" \
    --input-ipc-server="$socket" \
    --http-header-fields="Authorization: Bearer $TOKEN" \
    "${start_arg[@]}" \
    "$stream_url" &
  mpv_pid="$!"

  while kill -0 "$mpv_pid" 2>/dev/null; do
    sleep 15
    local pos dur pos_ms dur_ms
    pos="$(mpv_get "$socket" playback-time)"
    dur="$(mpv_get "$socket" duration)"
    [[ -n "$pos" ]] || continue
    pos_ms="$(jq -rn --arg v "$pos" '($v|tonumber|floor) * 1000')"
    if [[ -n "$dur" ]]; then
      dur_ms="$(jq -rn --arg v "$dur" '($v|tonumber|floor) * 1000')"
    else
      dur_ms="$duration_ms"
    fi
    printf '{"positionMs":%s,"durationMs":%s}\n' "$pos_ms" "$dur_ms" >"$state_file"
    save_progress "$item_id" "$pos_ms" "$dur_ms" "play" false
  done

  wait "$mpv_pid" || status=$?
  status="${status:-0}"

  local final_pos final_dur completed
  final_pos="$(jq -r '.positionMs // 0' "$state_file")"
  final_dur="$(jq -r '.durationMs // 0' "$state_file")"
  completed=false
  if (( final_dur > 0 && final_pos > 0 )); then
    if (( final_dur - final_pos <= 90000 || final_pos * 100 >= final_dur * 92 )); then
      completed=true
    fi
  fi
  save_progress "$item_id" "$final_pos" "$final_dur" "stop" "$completed"
  rm -rf "$socket_dir"
  return "$status"
}

main() {
  ensure_config
  local action item_id
  action="$(printf 'Movies\nTV Shows\nSearch\n' | rofi_dmenu -p "Popcorn")"
  case "$action" in
    Movies) item_id="$(choose_movie)" ;;
    "TV Shows") item_id="$(choose_episode)" ;;
    Search) item_id="$(choose_search_result)" ;;
    *) exit 0 ;;
  esac
  [[ -n "${item_id:-}" ]] || exit 0
  play_item "$item_id"
}

main "$@"
