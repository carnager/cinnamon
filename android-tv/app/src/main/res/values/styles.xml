<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">#050b0f</item>
        <item name="android:colorAccent">#f47b35</item>
    </style>

    <style name="PopcornPlayerButton">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/player_control_button</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">#FFFFFFFF</item>
    </style>

    <style name="PopcornPlayerTextButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/player_control_button</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PopcornPlayerTime">
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">#DDE8ECF2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PopcornPlayerTitle">
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#E8ECF2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
