#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/release [options]

Build a release bundle under dist/<version>.

Options:
  --server            Build the server/desktop component.
  --phone             Build the phone companion component.
  --androidtv         Build the Android TV component.
                      Component flags can be combined; without them, build all.
  --server-only       Legacy alias for --server.
  --skip-android      Legacy alias for --server.
  --skip-tests        Skip go test ./...
  --upload            Upload the selected Android APKs after building.
  --no-upload         Do not upload Android APKs.
  --quiet             Reduce successful build output.
  --version VERSION   Override release version name.
  --output DIR        Override output directory.
  -h, --help          Show this help.

Environment:
  POPCORN_RELEASE_VERSION, POPCORN_RELEASE_DIR
  POPCORN_ANDROID_VERSION_CODE, POPCORN_ANDROID_VERSION_NAME
  POPCORN_ANDROID_SIGNING_PROPERTIES
  POPCORN_ANDROID_STORE_FILE, POPCORN_ANDROID_STORE_PASSWORD
  POPCORN_ANDROID_KEY_ALIAS, POPCORN_ANDROID_KEY_PASSWORD
  POPCORN_RELEASE_UPLOAD, POPCORN_UPLOAD_SERVER, POPCORN_UPLOAD_USER,
  POPCORN_UPLOAD_PASSWORD, POPCORN_RELEASE_NOTES

Examples:
  scripts/release
  scripts/release --server
  scripts/release --phone
  scripts/release --phone --androidtv
USAGE
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
run_tests=1
build_server=1
build_phone=1
build_androidtv=1
component_selection=0
quiet=0
release_upload="${POPCORN_RELEASE_UPLOAD:-}"
version="${POPCORN_RELEASE_VERSION:-}"
out_dir="${POPCORN_RELEASE_DIR:-}"

select_component() {
  local component="$1"
  if [[ "$component_selection" == 0 ]]; then
    build_server=0
    build_phone=0
    build_androidtv=0
    component_selection=1
  fi
  case "$component" in
    server) build_server=1 ;;
    phone) build_phone=1 ;;
    androidtv) build_androidtv=1 ;;
  esac
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --server)
      select_component server
      ;;
    --phone)
      select_component phone
      ;;
    --androidtv)
      select_component androidtv
      ;;
    --server-only)
      build_server=1
      build_phone=0
      build_androidtv=0
      component_selection=1
      release_upload=0
      ;;
    --skip-android)
      build_server=1
      build_phone=0
      build_androidtv=0
      component_selection=1
      ;;
    --skip-tests)
      run_tests=0
      ;;
    --upload)
      release_upload=1
      ;;
    --no-upload)
      release_upload=0
      ;;
    --quiet)
      quiet=1
      ;;
    --version)
      [[ $# -ge 2 ]] || { echo "--version requires a value" >&2; exit 2; }
      version="$2"
      shift
      ;;
    --output)
      [[ $# -ge 2 ]] || { echo "--output requires a value" >&2; exit 2; }
      out_dir="$2"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

build_android=0
if [[ "$build_phone" == 1 || "$build_androidtv" == 1 ]]; then
  build_android=1
fi

version="${version:-$(cd "$repo_root" && git describe --tags --always --dirty)}"
out_dir="${out_dir:-$repo_root/dist/$version}"
commit="$(cd "$repo_root" && git rev-parse --short HEAD 2>/dev/null || true)"
build_time="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
android_version_code="${POPCORN_ANDROID_VERSION_CODE:-$(($(date -u +%s) / 60))}"
android_version_name="${POPCORN_ANDROID_VERSION_NAME:-$version}"
android_signing_properties="${POPCORN_ANDROID_SIGNING_PROPERTIES:-$HOME/.local/android/release-keys/popcorn.properties}"

if [[ -z "${JAVA_HOME:-}" && -d /usr/lib/jvm/java-21-openjdk ]]; then
  export JAVA_HOME=/usr/lib/jvm/java-21-openjdk
fi

apk_abis() {
  local apk="$1"
  unzip -l "$apk" 'lib/*/*.so' \
    | awk '/lib\// { split($4, parts, "/"); print parts[2] }' \
    | sort -u \
    | paste -sd, -
}

file_size() {
  du -h "$1" | awk '{ print $1 }'
}

signing_property() {
  local key="$1"
  if [[ -n "${!key:-}" ]]; then
    return 0
  fi
  [[ -f "$android_signing_properties" ]] || return 1
  awk -F= -v key="$key" '$1 == key && length($0) > length(key) + 1 { found=1 } END { exit found ? 0 : 1 }' "$android_signing_properties"
}

require_android_signing() {
  local missing=()
  local key
  for key in POPCORN_ANDROID_STORE_FILE POPCORN_ANDROID_STORE_PASSWORD POPCORN_ANDROID_KEY_ALIAS POPCORN_ANDROID_KEY_PASSWORD; do
    if ! signing_property "$key"; then
      missing+=("$key")
    fi
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Android release signing is not configured." >&2
    echo "Missing: ${missing[*]}" >&2
    echo "Set them as environment variables or create: $android_signing_properties" >&2
    exit 2
  fi
}

# Resolve a signing value from the environment first, then the properties file.
signing_value() {
  local key="$1"
  if [[ -n "${!key:-}" ]]; then
    printf '%s' "${!key}"
    return 0
  fi
  [[ -f "$android_signing_properties" ]] || return 1
  awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$android_signing_properties"
}

# Locate apksigner from the Android SDK so we can read v2/v3-signed APKs
# (keytool -jarfile cannot, since release APKs have no v1/JAR signature).
find_apksigner() {
  local candidates=() sdk bin sdkdir
  [[ -n "${ANDROID_HOME:-}" ]] && candidates+=("$ANDROID_HOME")
  [[ -n "${ANDROID_SDK_ROOT:-}" ]] && candidates+=("$ANDROID_SDK_ROOT")
  if [[ -f "$repo_root/android-tv/local.properties" ]]; then
    sdkdir="$(awk -F= '/^sdk.dir=/ { sub(/^sdk.dir=/, ""); print; exit }' "$repo_root/android-tv/local.properties")"
    [[ -n "$sdkdir" ]] && candidates+=("$sdkdir")
  fi
  candidates+=("$HOME/Android/Sdk" "$HOME/Library/Android/sdk")
  for sdk in "${candidates[@]}"; do
    bin="$(ls "$sdk"/build-tools/*/apksigner 2>/dev/null | sort -V | tail -1)"
    [[ -n "$bin" ]] && { printf '%s' "$bin"; return 0; }
  done
  bin="$(command -v apksigner 2>/dev/null || true)"
  [[ -n "$bin" ]] && { printf '%s' "$bin"; return 0; }
  return 1
}

# SHA-256 of the configured release keystore certificate.
release_cert_sha256() {
  local store_file store_pass key_alias
  store_file="$(signing_value POPCORN_ANDROID_STORE_FILE)" || return 1
  store_pass="$(signing_value POPCORN_ANDROID_STORE_PASSWORD)" || return 1
  key_alias="$(signing_value POPCORN_ANDROID_KEY_ALIAS)" || return 1
  keytool -list -v -keystore "$store_file" -storepass "$store_pass" -alias "$key_alias" 2>/dev/null \
    | awk -F'SHA256: ' '/SHA256:/ { gsub(/[: ]/, "", $2); print tolower($2); exit }'
}

# SHA-256 of the certificate an APK is actually signed with.
apk_cert_sha256() {
  local apk="$1"
  "$apksigner_bin" verify --print-certs "$apk" 2>/dev/null \
    | awk -F'SHA-256 digest: ' '/certificate SHA-256 digest:/ { print tolower($2); exit }'
}

# Guarantee a built APK is signed with the configured release key. A mis-signed
# (e.g. debug-signed) APK can never update an existing release-signed install, so
# refuse to publish one rather than ship an un-updatable release.
verify_release_signature() {
  local apk="$1" label="$2" got expected
  got="$(apk_cert_sha256 "$apk")"
  if [[ -z "$got" ]]; then
    echo "Could not read the signing certificate of $label." >&2
    echo "Checked: $apk" >&2
    exit 1
  fi
  if [[ "$got" != "$expected_release_cert" ]]; then
    echo "$label is NOT signed with the configured release key." >&2
    echo "  apk certificate:      $got" >&2
    echo "  release keystore key: ${expected_release_cert:-<unreadable>}" >&2
    echo "Publishing this would break in-app updates (Android rejects a signing-key change)." >&2
    echo "Check $android_signing_properties and android-tv/*/build.gradle.kts signingConfig." >&2
    exit 1
  fi
  if [[ "$quiet" == 0 ]]; then
    echo "  $label signed with release key ($got)"
  fi
}

copy_release_files() {
  cp "$repo_root/config.example.toml" "$out_dir/config.example.toml"
  cp "$repo_root/packaging/config.package.toml" "$out_dir/config.package.toml"
  cp "$repo_root/packaging/popcornd.service" "$out_dir/popcornd.service"
  cp "$repo_root/packaging/popcorn.sysusers" "$out_dir/popcorn.sysusers"
  cp "$repo_root/packaging/popcorn.tmpfiles" "$out_dir/popcorn.tmpfiles"
  cp "$repo_root/packaging/arch/PKGBUILD" "$out_dir/PKGBUILD"
  cp "$repo_root/packaging/arch/README.md" "$out_dir/ARCH.md"
  cp "$repo_root/README.md" "$out_dir/README.md"
}

mkdir -p "$out_dir"
out_dir="$(cd "$out_dir" && pwd -P)"
rm -f "$out_dir/app-update.toml" "$out_dir/SHA256SUMS"

echo "==> release $version"
echo "==> output $out_dir"

if [[ "$build_server" == 1 && "$run_tests" == 1 ]]; then
  echo "==> go test ./..."
  (cd "$repo_root" && go test ./...)
elif [[ "$build_server" == 1 ]]; then
  echo "==> skip go tests"
fi

if [[ "$build_android" == 1 ]]; then
  require_android_signing
  apksigner_bin="$(find_apksigner)" || {
    echo "Could not find 'apksigner' to verify APK signatures." >&2
    echo "Install Android SDK build-tools or set ANDROID_HOME/ANDROID_SDK_ROOT." >&2
    exit 2
  }
  expected_release_cert="$(release_cert_sha256 || true)"
  if [[ -z "$expected_release_cert" ]]; then
    echo "Could not read the release certificate from the configured keystore." >&2
    echo "Check POPCORN_ANDROID_STORE_FILE / STORE_PASSWORD / KEY_ALIAS (or $android_signing_properties)." >&2
    exit 2
  fi
fi

release_files=()

if [[ "$build_server" == 1 ]]; then
  echo "==> build server"
  (cd "$repo_root" && go build -trimpath -ldflags "-s -w -X popcorn/internal/version.Version=$version -X popcorn/internal/version.Commit=$commit -X popcorn/internal/version.BuildTime=$build_time" -o "$out_dir/popcornd" ./cmd/popcornd)
  (cd "$repo_root" && go build -trimpath -ldflags "-s -w" -o "$out_dir/popcorn-mpv" ./cmd/popcorn-mpv)
  # Static so popcorn-watch runs in minimal containers regardless of libc.
  (cd "$repo_root" && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o "$out_dir/popcorn-watch" ./cmd/popcorn-watch)
  copy_release_files
  release_files+=(
    popcornd
    popcorn-mpv
    popcorn-watch
    config.example.toml
    config.package.toml
    popcornd.service
    popcorn.sysusers
    popcorn.tmpfiles
    PKGBUILD
    ARCH.md
    README.md
  )
fi

if [[ "$build_android" == 1 ]]; then
  gradle_tasks=()
  [[ "$build_androidtv" == 1 ]] && gradle_tasks+=(":app:assembleRelease")
  [[ "$build_phone" == 1 ]] && gradle_tasks+=(":companion:assembleRelease")
  gradle_args=()
  [[ "$quiet" == 1 ]] && gradle_args+=("--quiet")

  echo "==> build Android"
  (cd "$repo_root/android-tv" && POPCORN_ANDROID_VERSION_CODE="$android_version_code" POPCORN_ANDROID_VERSION_NAME="$android_version_name" ./gradlew "${gradle_args[@]}" "${gradle_tasks[@]}")

  echo "==> verify APK signatures"
  if [[ "$build_androidtv" == 1 ]]; then
    tv_apk="$out_dir/popcorn-tv-$version.apk"
    cp "$repo_root/android-tv/app/build/outputs/apk/release/app-release.apk" "$tv_apk"
    tv_abis="$(apk_abis "$tv_apk")"
    expected_tv_abis="arm64-v8a,armeabi-v7a"
    if [[ "$tv_abis" != "$expected_tv_abis" ]]; then
      echo "Android TV APK contains unexpected native ABIs: ${tv_abis:-none}" >&2
      echo "Expected $expected_tv_abis. Check android-tv/app/build.gradle.kts ndk.abiFilters." >&2
      exit 1
    fi
    verify_release_signature "$tv_apk" "Android TV APK"
    release_files+=("popcorn-tv-$version.apk")
  fi

  if [[ "$build_phone" == 1 ]]; then
    companion_apk="$out_dir/popcorn-companion-$version.apk"
    cp "$repo_root/android-tv/companion/build/outputs/apk/release/companion-release.apk" "$companion_apk"
    verify_release_signature "$companion_apk" "Companion APK"
    release_files+=("popcorn-companion-$version.apk")
  fi
fi

(
  cd "$out_dir"
  sha256sum "${release_files[@]}" > SHA256SUMS
)

if [[ "$quiet" == 0 ]]; then
  echo "==> wrote:"
  printf '  %s\n' "${release_files[@]}" SHA256SUMS | sort

  if [[ "$build_server" == 1 ]]; then
    echo
    echo "==> server binaries:"
    echo "  popcornd:          $(file_size "$out_dir/popcornd")"
    echo "  popcorn-mpv:       $(file_size "$out_dir/popcorn-mpv")"
    echo "  popcorn-watch:     $(file_size "$out_dir/popcorn-watch")"
  fi

  if [[ "$build_android" == 1 ]]; then
    echo
    echo "==> APK version metadata:"
    echo "  versionCode:      $android_version_code"
    echo "  versionName:      $android_version_name"
    [[ "$build_androidtv" == 1 ]] && echo "  Android TV APK:   $(file_size "$tv_apk") ($tv_abis, release/R8)"
    [[ "$build_phone" == 1 ]] && echo "  Companion APK:    $(file_size "$companion_apk")"
  fi
fi

if [[ "$build_android" != 1 ]]; then
  exit 0
fi

if [[ -z "$release_upload" && -n "${POPCORN_UPLOAD_SERVER:-}" ]]; then
  release_upload=1
fi

case "${release_upload,,}" in
  1|true|yes)
    upload_updates=1
    ;;
  ""|0|false|no)
    upload_updates=0
    ;;
  *)
    echo "POPCORN_RELEASE_UPLOAD must be 1/true/yes or 0/false/no" >&2
    exit 2
    ;;
esac

if [[ "$upload_updates" == 1 ]]; then
  if [[ "$build_androidtv" == 1 ]]; then
    echo "==> upload Android TV"
    POPCORN_UPLOAD_VERSION_CODE="$android_version_code" \
      POPCORN_UPLOAD_VERSION_NAME="$android_version_name" \
      POPCORN_UPDATE_NOTES="${POPCORN_TV_RELEASE_NOTES:-${POPCORN_RELEASE_NOTES:-}}" \
      "$repo_root/scripts/upload-app-update" tv "$tv_apk"
  fi

  if [[ "$build_phone" == 1 ]]; then
    echo "==> upload phone"
    POPCORN_UPLOAD_VERSION_CODE="$android_version_code" \
      POPCORN_UPLOAD_VERSION_NAME="$android_version_name" \
      POPCORN_UPDATE_NOTES="${POPCORN_COMPANION_RELEASE_NOTES:-${POPCORN_RELEASE_NOTES:-}}" \
      "$repo_root/scripts/upload-app-update" companion "$companion_apk"
  fi
else
  echo "==> APKs ready in $out_dir"
fi
