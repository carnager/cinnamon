<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/player_controls_scrim" />

    <LinearLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_controls_panel"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="54dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@id/exo_center_controls"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@id/exo_play_pause"
                style="@style/PopcornPlayerButton"
                android:contentDescription="@string/player_play_pause"
                android:src="@drawable/exo_icon_play" />

            <ImageButton
                android:id="@id/exo_rew"
                style="@style/PopcornPlayerButton"
                android:contentDescription="@string/player_rewind"
                android:src="@drawable/exo_icon_rewind" />

            <ImageButton
                android:id="@id/exo_ffwd"
                style="@style/PopcornPlayerButton"
                android:contentDescription="@string/player_fast_forward"
                android:src="@drawable/exo_icon_fastforward" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/popcorn_subtitles"
                style="@style/PopcornPlayerButton"
                android:contentDescription="@string/player_subtitles"
                android:src="@drawable/exo_ic_subtitle_on" />

            <ImageButton
                android:id="@+id/popcorn_audio"
                style="@style/PopcornPlayerButton"
                android:contentDescription="@string/player_audio"
                android:src="@drawable/exo_ic_audiotrack" />

            <TextView
                android:id="@+id/popcorn_bandwidth"
                style="@style/PopcornPlayerTextButton"
                android:contentDescription="@string/player_bandwidth"
                android:text="@string/player_direct" />

        </LinearLayout>

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:focusable="true"
            app:ad_marker_color="#80FFFFFF"
            app:buffered_color="#66FFFFFF"
            app:played_ad_marker_color="#B34FD1A5"
            app:played_color="#FF4FD1A5"
            app:scrubber_color="#FFFFFFFF"
            app:scrubber_disabled_size="0dp"
            app:scrubber_dragged_size="16dp"
            app:scrubber_enabled_size="10dp"
            app:touch_target_height="28dp"
            app:unplayed_color="#99FFFFFF" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/popcorn_hls_progress"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:focusable="true"
            android:visibility="gone"
            app:ad_marker_color="#80FFFFFF"
            app:buffered_color="#66FFFFFF"
            app:played_ad_marker_color="#B34FD1A5"
            app:played_color="#FF4FD1A5"
            app:scrubber_color="#FFFFFFFF"
            app:scrubber_disabled_size="0dp"
            app:scrubber_dragged_size="16dp"
            app:scrubber_enabled_size="10dp"
            app:touch_target_height="28dp"
            app:unplayed_color="#99FFFFFF" />

        <LinearLayout
            android:id="@id/exo_time"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                style="@style/PopcornPlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/popcorn_hls_position"
                style="@style/PopcornPlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/popcorn_title"
                style="@style/PopcornPlayerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_weight="1" />

            <TextView
                android:id="@id/exo_duration"
                style="@style/PopcornPlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/popcorn_hls_duration"
                style="@style/PopcornPlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@id/exo_basic_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@id/exo_minimal_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</merge>
