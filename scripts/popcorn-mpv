#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -n "${POPCORN_MPV_BIN:-}" ]]; then
  exec "$POPCORN_MPV_BIN" "$@"
fi

if [[ -x "$repo_root/dist/popcorn-mpv" ]]; then
  exec "$repo_root/dist/popcorn-mpv" "$@"
fi

cd "$repo_root"
exec go run ./cmd/popcorn-mpv "$@"
